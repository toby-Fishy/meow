---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOOLS } from '../tools/registry.ts';
---

<BaseLayout title="Page not found" description="That page does not exist. Here are the tools that do.">
  <div class="hero">
    <h1>Not here.</h1>
  </div>
  <p class="hero__lede">That address does not exist. These do:</p>

  <ul class="tool-grid">
    {
      TOOLS.map((tool) => (
        <li>
          <a class="tool-card" href={`/tools/${tool.slug}/`}>
            <span class="tool-card__name">{tool.name}</span>
            <span class="tool-card__tagline">{tool.tagline}</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
