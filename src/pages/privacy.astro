---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site.ts';
---

<BaseLayout
  title="Privacy"
  description={`How ${SITE.name} handles your images: they never leave your browser. Here is exactly what that means, and what the ads can and cannot see.`}
>
  <div class="hero">
    <h1>Privacy</h1>
  </div>

  <div class="prose">
    <h2>Your images</h2>
    <p>
      The tools here run as JavaScript inside your own browser. When you choose
      an image it is read into memory on your device, processed there, and
      handed straight back to you. It is never uploaded, never stored and never
      seen by anyone else. Closing the tab discards it.
    </p>
    <p>
      This is not a policy promise — it is how the site is built. There is no
      server that could receive your file even if we wanted one.
    </p>

    <h2>Advertising</h2>
    <p>
      This site is paid for by advertising. Ad networks set cookies and may use
      them to show more relevant ads. The ad code cannot see anything you drop
      into a tool: your images are held in a part of the page it has no access
      to, and they are never sent anywhere it could read them from.
    </p>

    <h2>Analytics</h2>
    <p>
      We count page views to know which tools are worth building next. That
      records the page visited, not the files you used it on.
    </p>
  </div>
</BaseLayout>
