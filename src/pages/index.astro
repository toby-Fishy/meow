---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE } from '../config/site.ts';
import { TOOLS } from '../tools/registry.ts';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
  },
];
---

<BaseLayout title={SITE.name} description={SITE.description} jsonLd={jsonLd}>
  <div class="hero">
    <span class="eyebrow">No upload · No sign-up</span>
    <h1>Your images go nowhere.</h1>
  </div>
  <p class="hero__lede">
    Compress, convert and resize images without handing them to anyone. Every
    tool runs inside your browser, so your files stay on your device — and it
    is faster than uploading, because there is nothing to upload.
  </p>

  <ul class="tool-grid">
    {
      TOOLS.map((tool) => (
        <li>
          <a class="tool-card" href={`/tools/${tool.slug}/`}>
            <span class="tool-card__name">{tool.name}</span>
            <span class="tool-card__tagline">{tool.tagline}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <section class="section">
    <h2 class="section__title">Why it works this way</h2>
    <ul class="points">
      <li class="point">
        <p class="point__title">Nothing leaves your device</p>
        <p class="point__body">
          Other tools upload your photo to a server, process it there and send
          it back. Yours never goes anywhere, so there is nothing to leak, log
          or delete later.
        </p>
      </li>
      <li class="point">
        <p class="point__title">No queue to wait in</p>
        <p class="point__body">
          Work happens on a background thread on your own machine. There is no
          upload, no queue and no download — just the result.
        </p>
      </li>
      <li class="point">
        <p class="point__title">Works offline</p>
        <p class="point__body">
          Once a page has loaded it keeps working with no connection at all.
          Try it in aeroplane mode.
        </p>
      </li>
    </ul>
  </section>

  <AdSlot name="toolBottom" height={280} />
</BaseLayout>
